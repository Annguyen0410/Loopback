{
  "name": "messenger-self-chat",
  "version": "1.4.0",
  "description": "Electron desktop app — a private chat with yourself: notes, voice notes, screenshots, plus a world monitor.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.loopback.desktop",
    "productName": "Loopback",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "monitor.html",
      "monitor.css",
      "monitor-preload.js",
      "quick.html",
      "quick.js",
      "quick-preload.js",
      "shot-overlay.html",
      "shot-overlay.js",
      "shot-preload.js",
      "cam.html",
      "cam-overlay.js",
      "cam-preload.js",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loopback"
    }
  },
  "keywords": [
    "notes",
    "journal",
    "self-chat",
    "private",
    "notebook",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=18"
  }
}
