{
  "name": "messenger-self-chat",
  "version": "1.9.10",
  "description": "Electron desktop app — a private chat with yourself: notes, voice notes, screenshots, plus a world monitor.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:automation:ui": "vite build --config automation.vite.config.mjs",
    "build:automation:main": "node automation.esbuild.mjs",
    "build:automation": "npm run build:automation:ui && npm run build:automation:main && node scripts/copy-automation-html.mjs",
    "build": "npm run build:automation && electron-builder",
    "dist": "npm run build",
    "dev:automation": "vite --config automation.vite.config.mjs",
    "typecheck:automation": "tsc --noEmit -p tsconfig.automation.json",
    "test:unit": "node --test \"tests/*.test.js\" \"tests/*.test.mjs\"",
    "test": "npm run test:unit",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:all": "npm run test:unit && npm run typecheck:automation && npm run test:e2e"
  },
  "build": {
    "appId": "com.loopback.desktop",
    "productName": "Loopback",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "!src/automation/**/*",
      "!**/*.map",
      "!**/*.test.*",
      "monitor.html",
      "monitor.css",
      "monitor-preload.js",
      "quick.html",
      "quick.js",
      "quick-preload.js",
      "shot-overlay.html",
      "shot-overlay.js",
      "shot-preload.js",
      "review.html",
      "review.js",
      "review-preload.js",
      "cam.html",
      "cam-overlay.js",
      "cam-preload.js",
      "automation.html",
      "automation-preload.cjs",
      "automation-main/**/*",
      "automation-ui/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loopback"
    }
  },
  "keywords": [
    "notes",
    "journal",
    "self-chat",
    "private",
    "notebook",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.2.1",
    "node-cron": "^4.6.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18"
  }
}
